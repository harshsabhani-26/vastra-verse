// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  log      = ["warn", "error"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  phone                   String?
  newsletter              Boolean                  @default(false)
  role                    Role                     @default(USER)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  blockedAt               DateTime?
  blockedReason           String?
  failedLoginAttempts     Int                      @default(0)
  fcmToken                String?
  isBlocked               Boolean                  @default(false)
  isVIP                   Boolean                  @default(false)
  lastLoginAt             DateTime?
  lastLoginIP             String?
  lockedUntil             DateTime?
  passwordChangedAt       DateTime?
  phoneVerified           Boolean                  @default(false)
  twoFactorEnabled        Boolean                  @default(false)
  twoFactorSecret         String?
  whatsappOptIn           Boolean                  @default(false)
  accounts                Account[]
  activityLogs            ActivityLog[]
  addresses               Address[]
  couponUsages            CouponUsage[]
  customerNotes           CustomerNote[]
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  orders                  Order[]
  returnRequests          ReturnRequest[]
  sessions                Session[]
  wishlist                Wishlist[]
  cart                    Cart?

  @@index([role])
  @@index([createdAt])
  @@index([email])
  @@index([isVIP])
  @@index([role, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Session {
  sessionToken   String   @unique
  userId         String
  expires        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  lastActivityAt DateTime @default(now())
  userAgent      String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])   // Audit fix: session lookup by user
  @@index([expires])  // Audit fix: expired session cleanup cron
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String?
  otp       String
  type      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  phone     String?

  @@index([email, otp])
  @@index([phone, otp])
  @@index([email, type])
  @@index([phone, type])
  @@index([expiresAt])  // Audit fix: cleanup expired OTPs via cron
  @@index([createdAt])  // Audit fix: analytics + cleanup ordering
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  title     String
  firstName String
  lastName  String
  address1  String
  address2  String?
  country   String
  state     String
  city      String
  zipCode   String
  phone     String
  type      String   @default("Shipping")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])                  // Audit fix: covers user address queries
  @@index([userId, type])            // Audit fix: filter shipping vs billing
  @@index([userId, isDefault])       // Audit fix: fast default address lookup
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Product {
  id                String         @id @default(cuid())
  name              String
  description       String
  price             Decimal
  categoryId        String
  stock             Int            @default(0)
  isFeatured        Boolean        @default(false)
  sku               String?        @unique
  discount          Decimal?       @default(0)
  discountType      String?
  finalPrice        Decimal?
  lowStockThreshold Int?           @default(10)
  status            String         @default("DRAFT")
  shortDescription  String?
  fabricType        String?
  weaveType         String?
  borderDescription String?
  palluDescription  String?
  hasBlousePiece    Boolean        @default(true)
  blouseFabric      String?
  sareeLength       String?        @default("5.5 meters")
  blouseLength      String?        @default("0.8 meters")
  occasions         String[]
  careInstructions  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  isBestSeller      Boolean        @default(false)
  isNewArrival      Boolean        @default(false)
  colors            String[]
  orderItems        OrderItem[]
  category          Category       @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  wishlistItems     Wishlist[]
  cartItems         CartItem[]
  stories           Story[]

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([isBestSeller, status])
  @@index([isNewArrival, status])
  @@index([isFeatured, status])
  @@index([price])
  @@index([status, createdAt])
  @@index([categoryId, status])
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String?
  image        String?
  createdAt    DateTime  @default(now())
  displayOrder Int       @default(0)
  icon         String?
  isActive     Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  slug         String    @unique
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model MainCategory {
  id           String    @id @default(cuid())
  name         String
  href         String
  mobileImage  String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Order {
  id                 String            @id @default(cuid())
  userId             String
  status             OrderStatus       @default(PENDING)
  total              Decimal
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  cancellationReason String?
  cancelledAt        DateTime?
  cgst               Decimal?          @default(0)
  courierName        String?
  customerName       String?
  customerPhone      String?
  discount           Decimal?          @default(0)
  giftWrapCharge     Decimal?          @default(0)
  giftWrapEnabled    Boolean           @default(false)
  giftWrapMessage    String?
  gstRate            Decimal?          @default(18)
  igst               Decimal?          @default(0)
  paymentMethod      String?
  paymentStatus      PaymentStatus     @default(PENDING)
  refundStatus       OrderRefundStatus @default(NONE)
  sgst               Decimal?          @default(0)
  shippingAddress    String?
  shippingCharges    Decimal?          @default(0)
  shippingCity       String?
  shippingState      String?
  subtotal           Decimal?
  trackingNumber     String?
  couponUsages       CouponUsage[]
  user               User              @relation(fields: [userId], references: [id])
  items              OrderItem[]
  notes              OrderNote[]
  timeline           OrderTimeline[]
  payments           Payment[]
  refunds            Refund[]
  returnRequests     ReturnRequest[]
  shipments          Shipment[]

  @@index([createdAt])
  @@index([shippingState])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([paymentStatus])
  @@index([status, paymentStatus])
  @@index([userId, status])
  @@index([createdAt, id])
  // Covers the admin orders OR-filter query: paymentStatus + paymentMethod + createdAt sort
  @@index([paymentStatus, paymentMethod, createdAt])
}

model OrderItem {
  id          String       @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  price       Decimal
  order       Order        @relation(fields: [orderId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])    // Audit fix: order detail page lookup
  @@index([productId])  // Audit fix: product sales history
}

model Shipment {
  id                  String         @id @default(cuid())
  orderId             String
  providerShipmentId  String?        @unique
  awbNumber           String?        @unique
  courierName         String?
  labelUrl            String?
  trackingUrl         String?
  status              ShipmentStatus @default(PENDING)
  isReturn            Boolean        @default(false)
  pickupScheduledAt   DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  returnInitiatedAt   DateTime?
  estimatedDeliveryAt DateTime?
  weight              Decimal?       @default(0) // in kg
  length              Decimal?       @default(0) // in cm
  breadth             Decimal?       @default(0) // in cm
  height              Decimal?       @default(0) // in cm

  // Shiprocket Integration
  shiprocketOrderId String?                         // Shiprocket-specific order ID
  pickupPincode     String?                         // Origin pincode for pickup
  carrier           String   @default("SHIPROCKET") // Carrier identifier
  manifestUrl       String?                         // Manifest PDF URL

  // Cost & Weight Tracking
  actualWeight     Decimal? @default(0) // Actual weight from courier
  volumetricWeight Decimal? @default(0) // (L*B*H)/5000
  chargeableWeight Decimal? @default(0) // Max of actual vs volumetric
  shippingCost     Decimal? @default(0) // Forward shipping cost
  rtoCost          Decimal? @default(0) // Return shipping cost

  // Detailed Financial Breakdown
  codCollectionFee  Decimal? @default(0) // COD collection charges
  insuranceFee      Decimal? @default(0) // Insurance charges
  fuelSurcharge     Decimal? @default(0) // Fuel surcharge
  totalShippingCost Decimal? @default(0) // Total = shipping + rto + fees
  profitImpact      Decimal? @default(0) // Profit after shipping costs

  // COD Reconciliation
  codRemittance          Decimal?             @default(0) // Amount to be remitted
  codCollectedAmount     Decimal?             @default(0) // Amount actually collected
  codSettledAmount       Decimal?             @default(0) // Amount settled to bank
  codSettlementDate      DateTime? // Date of settlement
  codTransactionId       String? // Bank transaction ID
  codSettlementStatus    CodSettlementStatus? @default(PENDING) // Settlement tracking
  codSettlementReference String? // Reference from payment gateway/bank

  // Pickup Management
  pickupConfirmedAt DateTime? // When pickup was confirmed
  pickupManifestId  String? // Manifest ID from courier
  courierAgentName  String? // Agent who picked up

  providerResponse   Json? // Store raw API response
  trackingData       Json? // Store tracking timeline
  cancellationReason String?
  failureReason      String?
  createdBy          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  order              Order               @relation(fields: [orderId], references: [id])
  codReconciliations CodReconciliation[]
  ndrEvents          NdrEvent[]

  @@index([orderId])
  @@index([awbNumber])
  @@index([status])
  @@index([isReturn])
  @@index([createdAt])
  @@index([codSettlementStatus])
  @@index([shiprocketOrderId])
}

model CourierPerformance {
  id              String   @id @default(cuid())
  courierId       String? // Provider-specific courier ID
  courierName     String   @unique
  avgDeliveryTime Decimal  @default(0) // Average delivery time in days
  successRate     Decimal  @default(0) // Percentage of successful deliveries
  rtoRate         Decimal  @default(0) // Return-to-origin rate percentage
  score           Decimal  @default(0) // Composite performance score (0-100)
  totalShipments  Int      @default(0) // Total shipments processed
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([courierName])
  @@index([score])
  @@index([lastUpdated])
}

model CodReconciliation {
  id                  String    @id @default(cuid())
  shipmentId          String
  codAmount           Decimal // Expected COD amount
  collectedDate       DateTime? // When courier collected
  settlementDate      DateTime? // When settled to merchant
  settlementReference String? // Bank/gateway reference
  settlementStatus    String    @default("PENDING") // PENDING, SETTLED, DISPUTED
  gapAmount           Decimal   @default(0) // Difference between expected and settled
  metadata            Json? // Additional reconciliation data
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([settlementStatus])
  @@index([collectedDate])
  @@index([settlementDate])
}

model NdrEvent {
  id          String    @id @default(cuid())
  shipmentId  String
  awbNumber   String
  ndrCode     String
  ndrReason   String
  attemptDate DateTime
  actionTaken String?
  actionDate  DateTime?
  adminNotes  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@index([awbNumber])
  @@index([actionTaken])
}

model ReturnRequest {
  id                String           @id @default(cuid())
  orderId           String
  userId            String
  reason            ReturnReason
  description       String?
  status            ReturnStatus     @default(REQUESTED)
  inspectionStatus  InspectionStatus @default(PENDING)
  refundAmount      Decimal          @default(0)
  requestedAt       DateTime         @default(now())
  approvedAt        DateTime?
  rejectedAt        DateTime?
  receivedAt        DateTime?
  refundInitiatedAt DateTime?
  refundCompletedAt DateTime?
  adminNotes        String?

  order   Order        @relation(fields: [orderId], references: [id])
  user    User         @relation(fields: [userId], references: [id])
  items   ReturnItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([inspectionStatus])
  @@index([requestedAt])
}

model ReturnItem {
  id              String  @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int // Quantity to return (partial support)
  refundAmount    Decimal

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([returnRequestId])
  @@index([orderItemId])
}

model ProductImage {
  id           String      @id @default(cuid())
  productId    String
  url          String
  type         ImageType   @default(MAIN)
  position     Int         @default(0)
  alt          String?
  width        Int?
  height       Int?
  fileSize     Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  mediaAssetId String?     // FK to optimized variants — null for legacy images
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])

  @@index([productId])
  @@index([mediaAssetId])
}

/// Stores all WebP variants generated by the image optimization pipeline.
/// One MediaAsset row per upload — multiple ProductImage / banner rows can reference it.
model MediaAsset {
  id           String        @id @default(cuid())
  publicId     String        @unique // Cloudinary public_id (base, without variant suffix)
  originalName String        // Original filename before optimization
  assetType    AssetType     // hero | product | category | banner
  isMigrated   Boolean       @default(false) // true = converted by migration script
  // Variant URLs (all WebP, hosted on Cloudinary)
  desktopUrl   String?       // hero 1920w / promo 1440w
  mobileUrl    String?       // hero 768w / category mobile
  largeUrl     String?       // product 800x1000
  mediumUrl    String?       // product 400x500 / category desktop
  thumbUrl     String?       // product 150x188 / category 150x100
  blurUrl      String?       // 20px blur placeholder for all types
  // File size metadata (bytes per variant, stored as JSON: { desktop: 42000, mobile: 18000, ... })
  variantSizes Json?
  // Dimension metadata (stored as JSON: { desktop: "1920x800", mobile: "768x320", ... })
  variantDims  Json?
  // Compression stats
  originalBytes Int?          // Raw upload size in bytes
  totalSaved    Int?          // Bytes saved vs original
  conversionMs  Int?          // Time taken for sharp conversion
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  productImages ProductImage[]

  @@index([assetType])
  @@index([isMigrated])
  @@index([createdAt])
}


model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  content   String
  createdBy String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  event     String
  details   String?
  createdBy String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdBy String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id               String            @id @default(cuid())
  orderId          String
  amount           Decimal
  currency         String            @default("INR")
  status           PaymentStatusEnum @default(PENDING)
  method           PaymentMethodEnum
  gatewayProvider  String?
  gatewayOrderId   String?           @unique
  gatewayPaymentId String?           @unique
  gatewaySignature String?
  failureReason    String?
  failureCode      String?
  retryCount       Int               @default(0)
  subtotal         Decimal?
  cgst             Decimal?          @default(0)
  sgst             Decimal?          @default(0)
  igst             Decimal?          @default(0)
  gstRate          Decimal?          @default(18)
  metadata         Json?
  verifiedAt       DateTime?
  verifiedBy       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  order            Order             @relation(fields: [orderId], references: [id])
  refunds          Refund[]

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([gatewayOrderId])
  @@index([status, createdAt])
}

model Refund {
  id                    String           @id @default(cuid())
  paymentId             String
  orderId               String
  amount                Decimal
  reason                String
  status                RefundStatusEnum @default(PENDING)
  refundMethod          RefundMethodEnum @default(AUTOMATIC)
  gatewayRefundId       String?          @unique
  gatewayStatus         String?
  // Manual Refund Fields (COD)
  manualRefundUpiId     String?
  manualRefundBankName  String?
  manualRefundAccountNo String?
  manualRefundIfsc      String?
  manualRefundNotes     String?
  requestedBy           String
  requestedAt           DateTime         @default(now())
  approvedBy            String?
  approvedAt            DateTime?
  approvalNotes         String?
  processedBy           String?
  processedAt           DateTime?
  processingNotes       String?
  rejectedBy            String?
  rejectedAt            DateTime?
  rejectionReason       String?
  metadata              Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  order                 Order            @relation(fields: [orderId], references: [id])
  payment               Payment          @relation(fields: [paymentId], references: [id])
  returnRequest         ReturnRequest?   @relation(fields: [returnRequestId], references: [id])
  returnRequestId       String?

  @@index([paymentId])
  @@index([orderId])
  @@index([status])
  @@index([refundMethod])
}

model PaymentGatewaySettings {
  id            String   @id @default(cuid())
  provider      String   @unique
  isEnabled     Boolean  @default(false)
  isTestMode    Boolean  @default(true)
  apiKey        String?
  apiSecret     String?
  merchantId    String?
  webhookSecret String?
  webhookUrl    String?
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ShippingZone {
  id              String   @id @default(cuid())
  name            String
  type            String
  pincodes        Json
  minDeliveryDays Int      @default(2)
  maxDeliveryDays Int      @default(5)
  baseCharge      Decimal  @default(0)
  perKgCharge     Decimal  @default(0)
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

model CourierPartner {
  id                    String   @id @default(cuid())
  name                  String   @unique
  trackingUrlTemplate   String?
  supportsCOD           Boolean  @default(false)
  supportsInternational Boolean  @default(false)
  isActive              Boolean  @default(true)
  displayOrder          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isActive])
}

model ShippingSettings {
  id                       String   @id @default(cuid())
  freeShippingEnabled      Boolean  @default(false)
  freeShippingThreshold    Decimal  @default(0)
  codEnabled               Boolean  @default(true)
  codMaxAmount             Decimal  @default(10000)
  codExtraCharges          Decimal  @default(0)
  giftWrapEnabled          Boolean  @default(true)
  giftWrapCharge           Decimal  @default(50)
  giftWrapMessageMaxLength Int      @default(200)
  internationalEnabled     Boolean  @default(false)
  autoSendTrackingEmail    Boolean  @default(true)
  defaultCourierId         String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Coupon {
  id                   String        @id @default(cuid())
  code                 String        @unique
  description          String?
  type                 CouponType
  value                Decimal
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean       @default(true)
  maxUses              Int?
  maxUsesPerUser       Int?
  currentUses          Int           @default(0)
  minOrderValue        Decimal?
  applicableProducts   Json?
  applicableCategories Json?
  newUsersOnly         Boolean       @default(false)
  firstOrderOnly       Boolean       @default(false)
  autoApply            Boolean       @default(false)
  priority             Int           @default(0)
  views                Int           @default(0)
  totalRevenue         Decimal       @default(0)
  totalDiscount        Decimal       @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  usages               CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([type])
  @@index([startDate, endDate])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String?
  discountAmount Decimal
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order          Order?   @relation(fields: [orderId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
}

model StoreSettings {
  id                 String   @id @default(cuid())
  storeName          String   @default("My Store")
  tagline            String?
  logo               String?
  footerLogo         String?
  favicon            String?
  heroBg             String?
  footerBg           String?
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String   @default("India")
  zipCode            String?
  businessName       String?
  registrationNumber String?
  panNumber          String?
  operatingHours     Json?
  facebook           String?
  instagram          String?
  twitter            String?
  youtube            String?
  whatsapp           String?
  liveShoppingBg     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}



model TaxSettings {
  id                  String   @id @default(cuid())
  gstEnabled          Boolean  @default(true)
  gstin               String?
  stateOfReg          String?
  cgstRate            Decimal  @default(9)
  sgstRate            Decimal  @default(9)
  igstRate            Decimal  @default(18)
  defaultHsnCode      String?
  taxExemptCategories Json?
  createdAt           DateTime @default(now())
